[Unit]
Description=Umbriel Layout Change Notification Daemon for Noctalia
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/umbriel-layout-notify
Restart=always
RestartSec=2
Environment=PYTHONUNBUFFERED=1
Slice=app.slice

[Install]
WantedBy=graphical-session.target
