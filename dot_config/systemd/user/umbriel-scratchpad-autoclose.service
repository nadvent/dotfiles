[Unit]
Description=Umbriel Scratchpad Autoclose Daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/umbriel-scratchpad-autoclose
Restart=always
RestartSec=2
Environment=PYTHONUNBUFFERED=1
Slice=app.slice

[Install]
WantedBy=graphical-session.target
