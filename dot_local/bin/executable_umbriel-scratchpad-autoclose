#!/usr/bin/env python3
"""
Automatically dismisses empty Umbriel scratchpads when their last window is closed,
preventing the background from staying dimmed.
"""

import json
import subprocess
import sys
import time

def watch_windows():
    while True:
        try:
            proc = subprocess.Popen(
                ["umbriel", "subscribe", "windows"],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                bufsize=1,
            )
        except Exception:
            time.sleep(2)
            continue

        previous_all_ids = set()
        previous_visible_scratchpad_map = {}  # id -> scratchpad

        try:
            for line in proc.stdout:
                line = line.strip()
                if not line:
                    continue
                try:
                    msg = json.loads(line)
                except json.JSONDecodeError:
                    continue

                if msg.get("event") != "windows":
                    continue

                data = msg.get("data", [])

                current_all_ids = set()
                current_scratchpad_counts = {}  # scratchpad -> count of windows
                current_visible_scratchpad_map = {}

                for win in data:
                    wid = win.get("id")
                    if not wid:
                        continue
                    current_all_ids.add(wid)

                    sp = win.get("scratchpad")
                    if sp:
                        current_scratchpad_counts[sp] = current_scratchpad_counts.get(sp, 0) + 1
                        if win.get("visible"):
                            current_visible_scratchpad_map[wid] = sp

                # Detect if any destroyed window was a visible scratchpad window
                destroyed_ids = previous_all_ids - current_all_ids
                for wid in destroyed_ids:
                    pad = previous_visible_scratchpad_map.get(wid)
                    if pad:
                        # If that scratchpad has no windows left at all
                        if current_scratchpad_counts.get(pad, 0) == 0:
                            subprocess.run(
                                ["umbriel", "msg", f"scratchpad-toggle:{pad}"],
                                check=False,
                                stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL,
                            )

                previous_all_ids = current_all_ids
                previous_visible_scratchpad_map = current_visible_scratchpad_map
        except Exception:
            pass
        finally:
            if proc.poll() is None:
                proc.kill()
            time.sleep(1)

if __name__ == "__main__":
    watch_windows()
